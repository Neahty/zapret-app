<Project Sdk="Microsoft.NET.Sdk">

  <!-- Рисует окно приложения в PNG на заглушках — без прав администратора и без установки службы. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zapret.App\Zapret.App.csproj" />
    <ProjectReference Include="..\..\src\Zapret.Core\Zapret.Core.csproj" />
  </ItemGroup>

</Project>
