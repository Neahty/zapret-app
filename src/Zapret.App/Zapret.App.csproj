<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Zapret.Core\Zapret.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Zapret</AssemblyName>
    <RootNamespace>Zapret.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Запрет</Product>
    <!-- Сведения о файле (Свойства → Подробно): антивирусы и SmartScreen меньше доверяют exe без них. -->
    <AssemblyTitle>Запрет - обход блокировок Discord, YouTube, SoundCloud и Telegram</AssemblyTitle>
    <Description>Графическая оболочка для zapret-discord-youtube и прокси Telegram (tg-ws-proxy)</Description>
    <Company>Neahty</Company>
    <Authors>Neahty</Authors>
    <Copyright>© 2026 Neahty. zapret, zapret-discord-youtube, tg-ws-proxy, WinDivert - на условиях своих лицензий</Copyright>
    <RepositoryUrl>https://github.com/Neahty/zapret-app</RepositoryUrl>
    <Version>1.1.2</Version>
    <!-- Своя точка входа: тот же exe работает и службой прокси Telegram (Program.cs). -->
    <StartupObject>Zapret.App.Program</StartupObject>
  </PropertyGroup>

  <!-- WinForms нужен только для значка в трее, а его using'и конфликтуют с WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\zapret.zip" LogicalName="zapret.zip" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets\app-off.ico" LogicalName="app-off.ico" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
