<Application x:Class="Zapret.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Zapret.App"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ====== Палитра (тёмная, в духе Happ) ====== -->
        <Color x:Key="BgColor">#0B0D12</Color>
        <Color x:Key="AccentColor">#2EE6A6</Color>
        <Color x:Key="Accent2Color">#1FB5E8</Color>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151922" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#1D222D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#252B38" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="Text2Brush" Color="#8A93A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2EE6A6" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F5B94A" />
        <SolidColorBrush x:Key="BadBrush" Color="#FF5C6C" />
        <SolidColorBrush x:Key="BadSoftBrush" Color="#22FF5C6C" />
        <LinearGradientBrush x:Key="OnGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
            <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OffGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A303C" Offset="0" />
            <GradientStop Color="#1C212B" Offset="1" />
        </LinearGradientBrush>

        <!-- Tag хранит bool, а Value="True" в триггере — строка; сравниваем с настоящим bool. -->
        <sys:Boolean x:Key="True">True</sys:Boolean>

        <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- ====== Иконки (24×24, рисуются обводкой) ====== -->
        <Geometry x:Key="PowerIcon">M 12,2.5 L 12,11 M 6.3,5.8 A 8.4,8.4 0 1 0 17.7,5.8</Geometry>
        <Geometry x:Key="HomeIcon">M 3,11 L 12,3.5 L 21,11 M 5.5,9.5 L 5.5,20 L 18.5,20 L 18.5,9.5</Geometry>
        <Geometry x:Key="ListIcon">M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18</Geometry>
        <Geometry x:Key="GearIcon">M 12,8.5 A 3.5,3.5 0 1 0 12.01,8.5 M 12,2.5 L 12,5 M 12,19 L 12,21.5 M 2.5,12 L 5,12 M 19,12 L 21.5,12 M 5.3,5.3 L 7.1,7.1 M 16.9,16.9 L 18.7,18.7 M 5.3,18.7 L 7.1,16.9 M 16.9,7.1 L 18.7,5.3</Geometry>
        <Geometry x:Key="ChevronIcon">M 9,5 L 16,12 L 9,19</Geometry>
        <Geometry x:Key="ShieldIcon">M 12,2.5 L 20,5.5 L 20,11.5 C 20,16.5 16.5,20 12,21.5 C 7.5,20 4,16.5 4,11.5 L 4,5.5 Z</Geometry>
        <Geometry x:Key="BoltIcon">M 13,2.5 L 5,13.5 L 11.5,13.5 L 10.5,21.5 L 19,10 L 12.5,10 Z</Geometry>
        <Geometry x:Key="RefreshIcon">M 19.5,12 A 7.5,7.5 0 1 1 17,6.4 M 17.5,2.5 L 17.5,6.8 L 13.2,6.8</Geometry>
        <Geometry x:Key="MinIcon">M 6,12 L 18,12</Geometry>
        <Geometry x:Key="CloseIcon">M 7,7 L 17,17 M 17,7 L 7,17</Geometry>

        <!-- ====== Конвертеры ====== -->
        <local:EnumEqualsConverter x:Key="EnumEquals" />
        <local:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        <local:NotConverter x:Key="Not" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <local:CheckKindToBrushConverter x:Key="CheckKindToBrush" Good="{StaticResource AccentBrush}" Partial="{StaticResource WarnBrush}"
                                         Bad="{StaticResource BadBrush}" Neutral="{StaticResource Text2Brush}" />
        <local:StrategyTitleConverter x:Key="StrategyTitle" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ====== Текст ====== -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="StrokeIcon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- ====== Плоская кнопка-карточка ====== -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource OnGradient}" />
            <Setter Property="Foreground" Value="#0B0D12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Кнопки окна -->
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- Сегмент переключателя: выбран, когда Tag = True -->
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="Padding" Value="6,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{StaticResource True}">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Вкладка нижней навигации: активна, когда Tag = True -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,8" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{StaticResource True}">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Переключатель-«тумблер»: включён, когда Tag = True -->
        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="20" Height="20" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Text2Brush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{StaticResource True}">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource OnGradient}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====== Большая кнопка питания ====== -->
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="210" Height="210">
                            <Ellipse x:Name="Halo" Margin="-34" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#702EE6A6" Offset="0.5" />
                                        <GradientStop Color="#002EE6A6" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="HaloScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring" Fill="#11151D" Stroke="{StaticResource BorderBrush}" StrokeThickness="2" />
                            <Ellipse x:Name="Core" Margin="20" Fill="{StaticResource OffGradient}" RenderTransformOrigin="0.5,0.5" />
                            <Path x:Name="Icon" Data="{StaticResource PowerIcon}" Width="62" Height="62" Stretch="Uniform"
                                  Stroke="{StaticResource Text2Brush}" StrokeThickness="7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                            <Ellipse x:Name="Spinner" Margin="4" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                                     StrokeDashArray="18 400" StrokeDashCap="Round" Visibility="Collapsed"
                                     RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerAngle" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Core" Property="Fill" Value="{StaticResource OnGradient}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="White" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX" From="0.94" To="1.04" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY" From="0.94" To="1.04" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Spin">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerAngle" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Spin" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Core" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Core" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====== Тонкая полоса прокрутки ====== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#33FFFFFF" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
